
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Akses penuh untuk pemilik data (Login = Raja atas data sendiri)
    match /userProfiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Username mapping (Global Read)
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Platform Reviews (Global Read, Owner Write)
    match /platformReviews/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
