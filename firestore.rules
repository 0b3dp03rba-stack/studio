
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Fungsi bantu untuk cek admin yang lebih tangguh
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'creeppermoment@gmail.com' || 
        (exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'Admin')
      );
    }

    // Aturan Dasar: Profil Pengguna
    match /userProfiles/{userId} {
      allow read: if true;
      allow write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      // Izinkan publik update views
      allow update: if true;
      
      // Subkoleksi (Links & Groups)
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      }
    }
    
    // Global Stats & Config
    match /appConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if docId == 'globalStats' || isAdmin();
    }

    // Username mapping
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null || isAdmin();
    }

    // Platform Reviews
    match /platformReviews/{userId} {
      allow read: if true;
      allow write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // Collection Group Access (untuk admin memantau link terbaru secara global)
    match /{path=**}/links/{linkId} {
      allow read: if true; // Diperlukan agar pencarian global & admin feed bekerja
      allow write: if isAdmin() || (request.auth != null && request.auth.uid in path);
    }
    
    match /{path=**}/linkGroups/{groupId} {
      allow read: if true;
      allow write: if isAdmin() || (request.auth != null && request.auth.uid in path);
    }
  }
}
