
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Aturan Dasar: Pemilik bisa baca & tulis semua datanya
    match /userProfiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
      // Memungkinkan publik menambah views atau klik tanpa login
      allow update: if true;
      
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
        allow update: if true;
      }
    }
    
    // Username mapping
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Platform Reviews
    match /platformReviews/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
