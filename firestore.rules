
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Membuka akses baca publik sepenuhnya agar tidak ada kendala izin pada profil publik
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Spesifik untuk userProfiles demi keamanan tambahan saat menulis
    match /userProfiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Membolehkan publik melakukan increment clicks pada link
    match /userProfiles/{userId}/links/{linkId} {
      allow update: if true;
    }
    match /userProfiles/{userId}/linkGroups/{groupId}/links/{linkId} {
      allow update: if true;
    }
  }
}
