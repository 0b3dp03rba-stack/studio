
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // LOGIKA RAJA: Jika user login, berikan akses penuh ke SEMUA dokumen tanpa syarat.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
    // LOGIKA PUBLIK: Pengunjung publik bisa melihat profil dan menyumbang statistik.
    match /userProfiles/{userId} {
      allow read: if true;
      // Izinkan publik menambah angka views/statistik
      allow update: if true;
      
      match /links/{linkId} {
        allow read: if true;
        allow update: if true;
      }
      
      match /linkGroups/{groupId} {
        allow read: if true;
        allow update: if true;
        
        // Dukung nested links/groups secara publik
        match /{allSubcollections=**} {
          allow read: if true;
          allow update: if true;
        }
      }
    }

    match /usernames/{username} {
      allow read: if true;
    }

    match /platformReviews/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
