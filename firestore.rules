rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Fungsi Admin yang lebih ringan (Free check untuk email utama)
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'creeppermoment@gmail.com' || 
        (exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'Admin')
      );
    }

    // Aturan Global untuk Admin
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /userProfiles/{userId} {
      // Profil harus bisa dibaca publik (untuk halaman linktree)
      allow read: if true;
      // Hanya pemilik yang bisa edit
      allow write: if request.auth != null && request.auth.uid == userId;
      
      match /links/{linkId} {
        allow read: if true;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks']) || (request.auth != null && request.auth.uid == userId);
        allow create, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /linkGroups/{groupId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;

        match /links/{linkId} {
          allow read: if true;
          allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks']) || (request.auth != null && request.auth.uid == userId);
          allow create, delete: if request.auth != null && request.auth.uid == userId;
        }
      }
    }

    match /payments/{paymentId} {
      // User hanya boleh baca kueri miliknya sendiri (Wajib filter userId di client)
      allow list: if request.auth != null && query.limit <= 10 && request.auth.uid == request.query.filters.userId;
      // User boleh baca dokumen invoice tunggal miliknya
      allow get: if request.auth != null && resource.data.userId == request.auth.uid;
      // User boleh buat data payment (invoice)
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Admin punya akses penuh via rule global di atas
    }
    
    match /appConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /platformReviews/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /messages/{msgId} {
       allow read: if request.auth != null && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId);
       allow create: if request.auth != null;
       allow update: if request.auth != null && (request.auth.uid == resource.data.receiverId || isAdmin());
    }
  }
}