
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Sederhanakan total akses baca untuk profil publik
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Spesifik untuk userProfiles demi keamanan tambahan jika diperlukan
    match /userProfiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
