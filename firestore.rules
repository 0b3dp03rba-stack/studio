
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Aturan super sederhana untuk platform Linku
    // Mengizinkan baca publik untuk semua data profil agar tidak ada error permission
    match /userProfiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Mengizinkan update klik secara publik agar visitor bisa menambah counter
      match /links/{linkId} {
        allow read: if true;
        allow update: if true; 
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /linkGroups/{groupId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
        
        match /links/{linkId} {
          allow read: if true;
          allow update: if true;
          allow write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }
    
    // Username mapping harus bisa dibaca siapa saja
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // App Config untuk platform
    match /appConfig/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Fallback untuk koleksi lainnya (messages, dll)
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
