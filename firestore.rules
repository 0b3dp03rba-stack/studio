
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Fungsi bantu admin yang tangguh
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'creeppermoment@gmail.com' || 
        (exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'Admin')
      );
    }

    // AKSES MUTLAK ADMIN: Izinkan SEMUA operasi jika pengguna adalah Admin Utama
    // Memperbaiki akses Global Stats, Users, dan Collection Groups
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // ATURAN USER & PUBLIK
    match /userProfiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    match /appConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if (docId == 'globalStats' || docId == 'singletonConfig') || isAdmin();
    }

    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null || isAdmin();
    }

    match /platformReviews/{userId} {
      allow read: if true;
      allow write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // Collection Group Access (Wajib ada di top-level untuk queries global)
    match /{path=**}/links/{linkId} {
      allow read: if true;
    }
    match /{path=**}/linkGroups/{groupId} {
      allow read: if true;
    }
  }
}
