
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Fungsi bantu admin yang tangguh
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'creeppermoment@gmail.com' || 
        (exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'Admin')
      );
    }

    // AKSES MUTLAK ADMIN: Izinkan SEMUA operasi jika pengguna adalah Admin Utama
    // Ini memperbaiki error 'list' pada level root dan collection group
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }

    // ATURAN USER & PUBLIK
    match /userProfiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    match /appConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if docId == 'globalStats' || isAdmin();
    }

    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null || isAdmin();
    }

    match /platformReviews/{userId} {
      allow read: if true;
      allow write: if (request.auth != null && request.auth.uid == userId) || isAdmin();
    }

    // Rules untuk fitur fungsional lainnya
    match /messages/{msgId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId || isAdmin());
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == resource.data.receiverId || isAdmin());
    }

    match /withdrawalRequests/{reqId} {
      allow read: if (request.auth != null && request.auth.uid == resource.data.userId) || isAdmin();
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if isAdmin();
    }

    match /gmailBatches/{batchId} {
      allow read: if (request.auth != null && request.auth.uid == resource.data.userId) || isAdmin();
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if isAdmin();
      
      match /gmailSubmissions/{subId} {
        allow read: if (request.auth != null && request.auth.uid == resource.data.userId) || isAdmin();
        allow write: if isAdmin();
      }
    }

    match /submittedEmails/{email} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
    }

    // Collection Group Access (Wajib ada di top-level untuk queries global)
    match /{path=**}/links/{linkId} {
      allow read: if true;
    }
    match /{path=**}/linkGroups/{groupId} {
      allow read: if true;
    }
  }
}
