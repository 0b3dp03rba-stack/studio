
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'creeppermoment@gmail.com' || 
        (exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'Admin')
      );
    }

    // CRITICAL: Collection Group Rule for Spotlight & Admin Activity Feed
    // This allows public read access to all 'links' collections across the database.
    // MUST BE AT THE TOP to override more specific rules.
    match /{path=**}/links/{linkId} {
      allow read: if true;
    }

    match /userProfiles/{userId} {
      allow read: if true;
      allow write: if isOwner(userId) || isAdmin();
      
      match /links/{linkId} {
        allow read: if true;
        allow write: if isOwner(userId) || isAdmin();
      }
      
      match /linkGroups/{groupId} {
        allow read: if true;
        allow write: if isOwner(userId) || isAdmin();
        
        match /links/{linkId} {
          allow read: if true;
          allow write: if isOwner(userId) || isAdmin();
        }
      }
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /usernames/{username} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /platformReviews/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }
    
    match /appConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /messages/{messageId} {
      allow read, write: if isSignedIn();
    }
  }
}
