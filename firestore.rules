
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hak akses penuh untuk pemilik profil (userId)
    match /userProfiles/{userId} {
      allow read: if true;
      allow update: if true; // Untuk update views/clicks publik
      allow write, delete: if request.auth != null && request.auth.uid == userId;
      
      // Hak akses penuh untuk semua sub-koleksi (links, linkGroups, dll)
      match /{allSubcollections=**} {
        allow read: if true;
        allow update: if true;
        allow write, delete: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Akses global untuk usernames mapping
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Akses global untuk ulasan dan dokumen lainnya
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
