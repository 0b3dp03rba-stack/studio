
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "Profil pengguna Linku. AvatarUrl disimpan sebagai Base64 string.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "bio": { "type": "string" },
        "avatarUrl": { "type": "string", "description": "Base64 encoded image string (max 400x400px)" },
        "themeColor": { "type": "string" },
        "themeColorSecondary": { "type": "string" },
        "role": { "type": "string", "enum": ["User", "Admin"] },
        "isPremium": { "type": "boolean", "description": "Status premium untuk hapus WM & domain kustom." },
        "customDomain": { "type": "string", "description": "Domain pribadi user (contoh: budi.com)" },
        "views": { "type": "number" },
        "socialLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "platform": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "username", "role"]
    },
    "Payment": {
      "title": "Payment",
      "type": "object",
      "description": "Log transaksi pembayaran premium.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "success", "failed"] },
        "method": { "type": "string" },
        "qrisData": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Link": {
      "title": "Link",
      "type": "object",
      "description": "Tautan individu. ImageUrl disimpan sebagai Base64 string.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "groupId": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "imageUrl": { "type": "string", "description": "Base64 encoded image string" },
        "clicks": { "type": "number" },
        "isEnabled": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "url"]
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "/userProfiles/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "Profil utama pengguna."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/backend/entities/Payment" },
      "description": "Data transaksi pembayaran user."
    },
    "/usernames/{username}": {
      "schema": { "type": "object", "properties": { "userId": { "type": "string" } } },
      "description": "Registri username unik untuk mencegah duplikasi."
    },
    "/userProfiles/{userId}/links/{linkId}": {
      "schema": { "$ref": "#/backend/entities/Link" },
      "description": "Tautan mandiri."
    },
    "/userProfiles/{userId}/linkGroups/{groupId}": {
      "schema": { "type": "object" },
      "description": "Folder/Kelompok link."
    }
  }
}
