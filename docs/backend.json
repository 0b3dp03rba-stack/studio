
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "Profil pengguna Linktree.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "bio": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "role": { "type": "string", "enum": ["User", "Admin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "username", "role"]
    },
    "Link": {
      "title": "Link",
      "type": "object",
      "description": "Tautan yang ditampilkan di profil.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "icon": { "type": "string" },
        "order": { "type": "number" },
        "isEnabled": { "type": "boolean" },
        "clicks": { "type": "number" }
      },
      "required": ["id", "userId", "title", "url", "isEnabled"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/userProfiles/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "Profil pengguna."
    },
    "/userProfiles/{userId}/links/{linkId}": {
      "schema": { "$ref": "#/backend/entities/Link" },
      "description": "Daftar tautan milik pengguna."
    },
    "/usernames/{username}": {
      "schema": { "type": "object" },
      "description": "Mapping username unik ke userId."
    }
  }
}
