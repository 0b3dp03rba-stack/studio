
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "Profil pengguna Linku dengan kustomisasi desain.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "bio": { "type": "string" },
        "avatarUrl": { "type": "string", "description": "Base64 encoded image string" },
        "bannerUrl": { "type": "string", "description": "Base64 encoded cover image" },
        "themeColor": { "type": "string", "default": "#ff0000" },
        "themeColorSecondary": { "type": "string", "default": "#ffea00" },
        "profile_shape": { "type": "string", "enum": ["square", "circle", "rounded", "hexagon"], "default": "circle" },
        "layout_type": { "type": "string", "enum": ["classic", "split", "minimal"], "default": "classic" },
        "theme_style": { "type": "string", "enum": ["gradient", "glassmorphism", "solid", "neon"], "default": "gradient" },
        "font_family": { "type": "string", "default": "Inter" },
        "role": { "type": "string", "enum": ["User", "Admin"] },
        "isPremium": { "type": "boolean" },
        "customDomain": { "type": "string" },
        "views": { "type": "number" },
        "socialLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "platform": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Link": {
      "title": "Link",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "groupId": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "imageUrl": { "type": "string" },
        "clicks": { "type": "number" },
        "isEnabled": { "type": "boolean" },
        "button_style": { "type": "string", "enum": ["solid", "outline", "glassmorphism", "gradient"], "default": "solid" },
        "button_radius": { "type": "string", "enum": ["square", "rounded", "pill"], "default": "rounded" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google.com"]
  },
  "firestore": {
    "/userProfiles/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "Profil utama pengguna."
    },
    "/userProfiles/{userId}/links/{linkId}": {
      "schema": { "$ref": "#/backend/entities/Link" },
      "description": "Tautan mandiri."
    },
    "/userProfiles/{userId}/linkGroups/{groupId}/links/{linkId}": {
      "schema": { "$ref": "#/backend/entities/Link" },
      "description": "Tautan dalam grup."
    }
  }
}
